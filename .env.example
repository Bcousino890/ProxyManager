# Cambia estas claves antes de exponer el servicio; no subas claves reales.
PROXYMANAGER_EVALUATOR_KEY=
PROXYMANAGER_ADMIN_KEY=
# Genera con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROXYMANAGER_CREDENTIAL_KEY=
PROXYMANAGER_ALLOWED_HOSTS=
PROXYMANAGER_EXPECTED_TEXT=
PROXYMANAGER_DB_PATH=proxymanager.db
PROXYMANAGER_SESSION_TTL_SECONDS=3600
PROXYMANAGER_TIMEOUT_SECONDS=15
PROXYMANAGER_MAX_RESPONSE_BYTES=1000000
PROXYMANAGER_MONTHLY_BUDGET_USD=25

PROXYMANAGER_HEALTH_CONCURRENCY=2
PROXYMANAGER_HEALTH_QUEUE_LIMIT=20
# Con PROXYMANAGER_STRICT=1 el servicio no arranca si faltan claves (>=16 caracteres, distintas),
# clave Fernet o allowlist. Úsalo siempre fuera de desarrollo local.
PROXYMANAGER_STRICT=
PROXYMANAGER_AUDIT_RETENTION_DAYS=30
PROXYMANAGER_RATE_LIMIT_REQUESTS=60
PROXYMANAGER_RATE_LIMIT_WINDOW_SECONDS=60
# Alcances de la clave de evaluación (admin tiene todos): system:read,sessions,scrape,proxies:read,proxies:write,checks:write,audit:read
PROXYMANAGER_EVALUATOR_SCOPES=system:read,sessions,scrape,proxies:read
PROXYMANAGER_HEALTH_MAX_ATTEMPTS=3
PROXYMANAGER_HEALTH_LEASE_SECONDS=120
PROXYMANAGER_HEALTH_POLL_SECONDS=0.2
PROXYMANAGER_PROXY_WINDOW_SECONDS=3600
PROXYMANAGER_PROXY_MIN_SUCCESS_RATE=0.5
PROXYMANAGER_PROXY_MAX_INFLIGHT=5
