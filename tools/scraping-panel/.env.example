# Archivo de ejemplo para las credenciales de proxies
# Copiar este archivo a .env y rellenar con las credenciales reales

# Clave API para el panel de scraping
SCRAPING_API_KEY=your_api_key_here

# Configuración del servidor
SCRAPING_SERVER_HOST=0.0.0.0
SCRAPING_SERVER_PORT=8080

# Configuración de proxies
MAX_CONCURRENT=5
SCRAPING_TIMEOUT=30
SCRAPING_RETRY_ATTEMPTS=3

# Credenciales de los proxies Decodo (ejemplo)
PROXY1_PROTOCOL=http
PROXY1_HOST=proxy1.decodo.com
PROXY1_PORT=8080
PROXY1_USER=user1
PROXY1_PASS=pass1

PROXY2_PROTOCOL=http
PROXY2_HOST=proxy2.decodo.com
PROXY2_PORT=8080
PROXY2_USER=user2
PROXY2_PASS=pass2

PROXY3_PROTOCOL=http
PROXY3_HOST=proxy3.decodo.com
PROXY3_PORT=8080
PROXY3_USER=user3
PROXY3_PASS=pass3

PROXY4_PROTOCOL=http
PROXY4_HOST=proxy4.decodo.com
PROXY4_PORT=8080
PROXY4_USER=user4
PROXY4_PASS=pass4

PROXY5_PROTOCOL=http
PROXY5_HOST=proxy5.decodo.com
PROXY5_PORT=8080
PROXY5_USER=user5
PROXY5_PASS=pass5