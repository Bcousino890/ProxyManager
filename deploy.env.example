# Copia a .env en el servidor y rellena. NUNCA subas .env a git.
PM_DOMAIN=panel.tu-dominio.example
# Claves distintas, de >=16 caracteres (p. ej. openssl rand -base64 24)
PROXYMANAGER_ADMIN_KEY=
PROXYMANAGER_EVALUATOR_KEY=
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  (guárdala: sin ella no se descifran las credenciales)
PROXYMANAGER_CREDENTIAL_KEY=
# Solo destinos PROPIOS o autorizados, separados por comas
PROXYMANAGER_ALLOWED_HOSTS=
PROXYMANAGER_EXPECTED_TEXT=
PROXYMANAGER_MONTHLY_BUDGET_USD=25
