# Copia a deploy/.env y rellena. No subas este archivo con valores reales.
# Dominio sslip.io: IP del VPS con guiones, p. ej. IP 203.0.113.10 -> proxymanager.203-0-113-10.sslip.io
DOMAIN=
PROXYMANAGER_ADMIN_KEY=
# Genera con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROXYMANAGER_CREDENTIAL_KEY=
PROXYMANAGER_SUPPORT_EMAIL=
# Abre /scrape a cualquier host HTTPS público (se siguen rechazando IP privadas y PROXYMANAGER_BLOCKED_HOSTS).
# Déjalo en false hasta aprobar la política de uso aceptable.
PROXYMANAGER_ALLOW_ANY_PUBLIC_HOST=false
PROXYMANAGER_BLOCKED_HOSTS=
PROXYMANAGER_SIGNUP_ENABLED=true
PROXYMANAGER_FREE_CREDITS=100
PROXYMANAGER_CREDITS_PER_REQUEST=1
PROXYMANAGER_CREDITS_PER_PROXIED_REQUEST=2
PROXYMANAGER_RATE_LIMIT_PER_MINUTE=60
